{
  "name": "mim-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ingest, enrichment and publishing for Meet in Motion. Kept out of Directus so a broken scraper cannot take the CMS down with it.",
  "scripts": {
    "ingest": "node src/index.mjs ingest",
    "enrich": "node src/index.mjs enrich",
    "schedule": "node src/index.mjs schedule",
    "gaps": "node src/index.mjs gaps",
    "variants": "node src/index.mjs variants",
    "migrate": "node src/migrate.mjs",
    "sources": "node src/index.mjs sources",
    "test": "node --test --test-concurrency=1 'test/*.test.mjs'",
    "publish": "node src/index.mjs publish",
    "remind": "node src/index.mjs remind"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "pg": "^8.13.0",
    "zod": "^4.5.4"
  }
}
