# Random long string used to sign Payload's auth tokens. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# SQLite database file. A relative "file:" path is created automatically.
DATABASE_URI=file:./cookie-training.db

# Optional. Powers the "pre-fill with AI" sparkle button when adding a new
# exercise (get a key at https://console.anthropic.com). Without it, that
# button shows an error but the rest of the app works normally.
ANTHROPIC_API_KEY=
