# Random long string used to sign Payload's auth tokens. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# SQLite database file. A relative "file:" path is created automatically.
DATABASE_URI=file:./cookie-training.db

# Optional. Powers the "pre-fill with AI" sparkle button when adding a new
# exercise (get a key at https://console.anthropic.com). Without it, that
# button shows an error but the rest of the app works normally.
ANTHROPIC_API_KEY=

# Optional. Enables "Import from Google Drive" on the session form. Leave
# blank and that button simply doesn't appear; local file upload is
# unaffected. These three are browser-visible by design — that's how
# Google's client-side OAuth works, and they're restricted by the
# authorised origins you set on the credential, not by secrecy.
#
# To get them, at https://console.cloud.google.com:
#   1. Create a project (or reuse one).
#   2. APIs & Services > Library: enable "Google Picker API" and
#      "Google Drive API".
#   3. APIs & Services > OAuth consent screen: set it up as External, and
#      add your own Google account under "Test users".
#   4. Credentials > Create credentials > OAuth client ID > Web application.
#      Add your site's origin (e.g. http://157.245.199.51) under
#      "Authorised JavaScript origins". The client ID goes below.
#   5. Credentials > Create credentials > API key. Restrict it to your
#      origin under "Website restrictions". The key goes below.
#   6. The app ID is your project *number* (Cloud console dashboard), not
#      the project name.
#
# Scope used is drive.file, so the app only ever sees the files you pick.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
