# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- database ---
DB_USER=mim
DB_PASSWORD=change-me
DB_DATABASE=mim
DB_PORT=5432
DATABASE_URL=postgres://mim:change-me@localhost:5432/mim

# --- directus ---
# SECRET signs access tokens. Generate one: openssl rand -base64 32
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=you@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
DIRECTUS_URL=http://localhost:8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_PORT=8055

# --- public site ---
CORS_ORIGIN=http://localhost:3000

# --- worker ---
# Eventbrite private token (Account Settings → Developer Links → API Keys).
# Note: this grants access to events you own or that organisers have authorised.
# There is no public event search API — see docs/worker.md.
EVENTBRITE_TOKEN=

# Postgres URL used by the worker's integration tests. Point it at a scratch
# database carrying schema/*.sql — the tests TRUNCATE tables.
TEST_DATABASE_URL=

# Anthropic API key for the enrichment pass. The SDK also accepts an
# `ant auth login` profile, in which case this can stay empty.
ANTHROPIC_API_KEY=
# Optional overrides. Effort is the cost lever worth measuring: high is the
# default because these judgements are the product; medium is the step-down.
ENRICH_MODEL=claude-opus-5
ENRICH_EFFORT=high

# Public site origin, used to build the canonical link in generated copy.
SITE_URL=https://meetinmotion.sg
VARIANT_MODEL=claude-opus-5
VARIANT_EFFORT=medium

# --- public site (site/.env.local) ---
# A Directus static token with read access to the published collections.
DIRECTUS_TOKEN=

# --- telegram (see docs/telegram-setup.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
